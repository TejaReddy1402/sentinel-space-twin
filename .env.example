# Backend
BACKEND_PORT=8787
PUBLIC_BASE_URL=http://localhost:8787

# STAC catalogue used for no-key Sentinel scene discovery
STAC_API_URL=https://earth-search.aws.element84.com/v1/search
STAC_COLLECTION=sentinel-2-l2a

# Optional production-grade rendered imagery / indices
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
SENTINEL_HUB_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
SENTINEL_HUB_PROCESS_URL=https://sh.dataspace.copernicus.eu/api/v1/process

# Optional VLM
VLM_PROVIDER=none
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VLM_MODEL=qwen2.5vl:7b

# Optional external live APIs
OPENSKY_ENABLED=false
AIS_PROVIDER=none
