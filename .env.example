# TERRAINGRID Backend — copy to .env and fill in values

# Public URL returned to frontend for static asset links
PUBLIC_BASE_URL=http://localhost:8787

# STAC search (free, no key)
STAC_API_URL=https://earth-search.aws.element84.com/v1/search
STAC_TIMEOUT_SECONDS=35

# Sentinel Hub (optional — enables real RGB/NDVI renders)
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# Ollama VLM (optional — enables scene explanation)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VLM_MODEL=qwen2.5vl:7b

# CORS — comma-separated allowed origins (defaults to * for dev)
# Production: https://terraingrid.vercel.app,https://www.terraingrid.io
CORS_ORIGINS=*
